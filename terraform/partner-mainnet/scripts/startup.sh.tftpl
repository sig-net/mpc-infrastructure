#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/mpc-startup.log | logger -t mpc-startup -s 2>/dev/console) 2>&1

echo "Starting multichain startup script"

mkdir -p /var/redis
mkdir -p /var/lib/chain-signatures/bootstrap
mkdir -p /var/lib/chain-signatures/config
mkdir -p /var/lib/chain-signatures/state
mkdir -p /var/log/chain-signatures

systemctl start docker || true
until systemctl is-active --quiet docker; do
  echo "Waiting for docker to become active"
  sleep 2
  systemctl start docker || true
done

cat >/var/lib/chain-signatures/bootstrap/bootstrap.env <<'EOF'
%{ for item in bootstrap_static_env ~}
${item.name}=${item.value}
%{ endfor ~}
PARTICIPANT_NAME=${participant_name}
MPC_NODE_ID=${node_id}
MPC_GCP_PROJECT_ID=${project_id}
MPC_ACCOUNT_ID=${account_id}
MPC_LOCAL_ADDRESS=${local_address}
MPC_ENV=${env_name}
MANIFEST_URL=${manifest_url}
MANIFEST_CHANNEL=${manifest_channel}
TRUSTED_MANIFEST_PUBKEY=/var/lib/chain-signatures/bootstrap/manifest.pub
DOCKER_CONTAINER_NAME=multichain
MANAGED_ENV_PATH=/var/lib/chain-signatures/config/managed.env
APP_LAUNCH_SPEC_PATH=/var/lib/chain-signatures/config/app-container.json
STATE_FILE_PATH=/var/lib/chain-signatures/state/agent-state.json
POLL_INTERVAL_SECONDS=${poll_interval_seconds}
EOF

cat >/var/lib/chain-signatures/bootstrap/manifest.pub <<'EOF'
${trusted_manifest_pubkey}
EOF

cat >/var/lib/chain-signatures/config/managed.env <<'EOF'
%{ for key, value in managed_env ~}
${key}=${value}
%{ endfor ~}
EOF

cat >/var/lib/chain-signatures/config/app-container.json <<EOF
{
  "version": 1,
  "name": "multichain",
  "image": "${image}",
  "command": [],
  "env_files": [
    "/var/lib/chain-signatures/bootstrap/bootstrap.env",
    "/var/lib/chain-signatures/config/managed.env"
  ],
  "volumes": [
    "/var/redis:/data",
    "/var/lib/chain-signatures/state:/var/lib/chain-signatures/state"
  ],
  "ports": ["${image_port}:${image_port}"],
  "restart_policy": "unless-stopped"
}
EOF

chmod 0600 /var/lib/chain-signatures/bootstrap/bootstrap.env
chmod 0644 /var/lib/chain-signatures/bootstrap/manifest.pub
chmod 0600 /var/lib/chain-signatures/config/managed.env
chmod 0644 /var/lib/chain-signatures/config/app-container.json

docker rm -f multichain || true
docker pull "${image}"

docker run -d \
  --name multichain \
  --restart unless-stopped \
  -p ${image_port}:${image_port} \
  -v /var/redis:/data \
  -v /var/lib/chain-signatures/state:/var/lib/chain-signatures/state \
  --env-file /var/lib/chain-signatures/bootstrap/bootstrap.env \
  --env-file /var/lib/chain-signatures/config/managed.env \
  "${image}"

docker rm -f chain-signatures-operator || true
docker pull "${operator_image}"

docker run -d \
  --name chain-signatures-operator \
  --restart unless-stopped \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /var/lib/chain-signatures/bootstrap:/var/lib/chain-signatures/bootstrap:ro \
  -v /var/lib/chain-signatures/config:/var/lib/chain-signatures/config \
  -v /var/lib/chain-signatures/state:/var/lib/chain-signatures/state \
  -v /var/log/chain-signatures:/var/log/chain-signatures \
  "${operator_image}" \
  cs-agent daemon --bootstrap /var/lib/chain-signatures/bootstrap/bootstrap.env

echo "Startup script completed"
